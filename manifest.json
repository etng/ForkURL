{
  "manifest_version": 3,
  "name": "ForkURL",
  "description": "在 GitHub / npm / GitLab 等页面一键跳转 Pages、Raw、IDE、CDN 等工具，规则可远程同步与自定义",
  "version": "2.2.1",
  "homepage_url": "https://forkurl.0o666.xyz/",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ForkURL",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
